    "test:all": "npm test && npm run test:e2e",
    "vendor": "node scripts/vendor.mjs",
    "release": "node scripts/release.mjs",
    "desktop": "node scripts/desktop.mjs",
    "desktop:start": "node scripts/desktop.mjs && cd desktop && npm install && npx electron .",
    "test:desktop": "node scripts/desktop.mjs && node --test tests/desktop/smoke.mjs"
  },
